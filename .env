# Postgres
POSTGRES_USER=logs
POSTGRES_PASSWORD=logs
POSTGRES_DB=logs
POSTGRES_HOST=db
POSTGRES_PORT=5432

# MinIO
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=minio
MINIO_SECRET_KEY=minio12345
MINIO_SECURE=false
MINIO_BUCKET=logs
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9002

# App
APP_NAME=logflow
APP_PORT=8000
LOG_LEVEL=DEBUG
INTERCEPT_HANDLER_LOGGING=false
# Количество воркеров Gunicorn (0=автовычисление: 2*CPU+1)
WORKERS=1

