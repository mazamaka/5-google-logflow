# Postgres
POSTGRES_USER=logs
POSTGRES_PASSWORD=logs
POSTGRES_DB=logs
POSTGRES_HOST=db
POSTGRES_PORT=5432

# MinIO
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=minio
MINIO_SECRET_KEY=minio12345
MINIO_SECURE=false
MINIO_BUCKET=logs

# App
APP_NAME=logflow
APP_ENV=dev
LOG_LEVEL=INFO

# Host ports mapping и локальный порт приложения
# APP_PORT используется и для docker-compose (хостовый порт), и для локального uvicorn
APP_PORT=8000
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9002

# Подсказки для локальной разработки (когда API запускается не в контейнере):
# Укажите подключение к сервисам, доступным с хоста:
# POSTGRES_HOST=localhost
# MINIO_ENDPOINT=localhost:${MINIO_API_PORT}

# Количество воркеров Gunicorn (0=автовычисление: 2*CPU+1)
WORKERS=0

# Опционально можно задать полный URL БД; если не задан, будет собран из частей
# DATABASE_URL=postgresql+asyncpg://logs:logs@db:5432/logs
